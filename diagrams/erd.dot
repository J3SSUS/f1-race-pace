digraph ERD {
  graph [rankdir=LR, splines=true, nodesep=0.35, ranksep=1.1, fontname="Helvetica", bgcolor="white", pad=0.3, labelloc=t, fontsize=22, label=<<B>F1 race pace MLOps: entity-relationship diagram</B>>];
  node [shape=plain, fontname="Helvetica", fontsize=11];
  edge [fontname="Helvetica", fontsize=9, color="#7D8780", dir=both, arrowtail=teetee, arrowhead=crowtee, arrowsize=0.8];
