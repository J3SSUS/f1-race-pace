  metrics [label=<<TABLE BORDER="1" COLOR="#2F6FEB" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE8FB"><TR><TD COLSPAN="3" BGCOLOR="#2F6FEB"><FONT COLOR="white"><B>metrics</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="metric_id"><B>metric_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_version_id">model_version_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="race_id">race_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="split">split</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">train, test, walk_forward</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="segment_type">segment_type</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">overall, team, circuit_type</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="segment_value">segment_value</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">text null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="metric_name">metric_name</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">mae, rmse, r2, pairwise_acc</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="value">value</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">float</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="computed_at">computed_at</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">timestamptz</FONT></TD></TR></TABLE>>];
  shap_values [label=<<TABLE BORDER="1" COLOR="#2F6FEB" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="#DCE8FB"><TR><TD COLSPAN="3" BGCOLOR="#2F6FEB"><FONT COLOR="white"><B>shap_values</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="entry_id"><B>entry_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>PK·FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_version_id"><B>model_version_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>PK·FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="feature_id"><B>feature_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>PK·FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="shap_value">shap_value</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">float</FONT></TD></TR></TABLE>>];
  drift_reports [label=<<TABLE BORDER="1" COLOR="#6B756E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="DASHED" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#6B756E"><FONT COLOR="white"><B>drift_reports</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="drift_report_id"><B>drift_report_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>PK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="model_version_id">model_version_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="through_race_id">through_race_id</TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="mae_change_pct">mae_change_pct</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">float</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="n_drifted_features">n_drifted_features</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="triggered_retrain">triggered_retrain</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">bool</FONT></TD></TR></TABLE>>];
  drift_feature_results [label=<<TABLE BORDER="1" COLOR="#6B756E" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="DASHED" BGCOLOR="#FFFFFF"><TR><TD COLSPAN="3" BGCOLOR="#6B756E"><FONT COLOR="white"><B>drift_feature_results</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="drift_report_id"><B>drift_report_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>PK·FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="feature_id"><B>feature_id</B></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#8A3B00"><B>PK·FK</B></FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="statistic">statistic</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">float</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="p_value">p_value</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">float</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="is_drifted">is_drifted</TD><TD ALIGN="LEFT"> </TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555">bool</FONT></TD></TR></TABLE>>];
  circuits -> races [headport="circuit_id:w", tailport="e"];
  races -> race_entries [headport="race_id:w", tailport="e"];
  drivers -> race_entries [headport="driver_id:w", tailport="e"];
  teams -> race_entries [headport="team_id:w", tailport="e"];
  feature_sets -> feature_set_items [headport="feature_set_id:w", tailport="e"];
  features -> feature_set_items [headport="feature_id:w", tailport="e"];
  race_entries -> feature_values [headport="entry_id:w", tailport="e"];
  features -> feature_values [headport="feature_id:w", tailport="e"];
  feature_sets -> feature_values [headport="feature_set_id:w", tailport="e"];
  feature_sets -> model_versions [headport="feature_set_id:w", tailport="e"];
  races -> model_versions [headport="trained_through_race_id:w", tailport="e"];
  model_versions -> champion_history [headport="model_version_id:w", tailport="e"];
  races -> prediction_runs [headport="race_id:w", tailport="e"];
  model_versions -> prediction_runs [headport="model_version_id:w", tailport="e"];
  prediction_runs -> predictions [headport="prediction_run_id:w", tailport="e"];
  race_entries -> predictions [headport="entry_id:w", tailport="e"];
  model_versions -> predictions [headport="model_version_id:w", tailport="e"];
  race_entries -> ground_truth [headport="entry_id:w", tailport="e", arrowhead=teetee];
  model_versions -> metrics [headport="model_version_id:w", tailport="e"];
  races -> metrics [headport="race_id:w", tailport="e", arrowhead=crowodot];
  race_entries -> shap_values [headport="entry_id:w", tailport="e"];
  model_versions -> shap_values [headport="model_version_id:w", tailport="e"];
  features -> shap_values [headport="feature_id:w", tailport="e"];
  model_versions -> drift_reports [headport="model_version_id:w", tailport="e", style=dashed];
  races -> drift_reports [headport="through_race_id:w", tailport="e", style=dashed];
  drift_reports -> drift_feature_results [headport="drift_report_id:w", tailport="e", style=dashed];
  features -> drift_feature_results [headport="feature_id:w", tailport="e", style=dashed];
  subgraph cluster_leg { label="Legend"; fontsize=12; color="#9AA39B"; style=rounded;
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD BGCOLOR="#2F6FEB" WIDTH="14"> </TD><TD ALIGN="LEFT">Supabase: public read (anon key, RLS read-only)</TD></TR><TR><TD BGCOLOR="#6B756E" WIDTH="14"> </TD><TD ALIGN="LEFT">Supabase: private (RLS on, no anon policy; service key only)</TD></TR><TR><TD BORDER="1" STYLE="DASHED" WIDTH="14"> </TD><TD ALIGN="LEFT">After the core (dashed edges; private)</TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT"><FONT POINT-SIZE="9">PK primary key · FK foreign key · UQ unique<BR/>crow's foot = many, bar = one, circle = optional</FONT></TD></TR></TABLE>>]; }
}
