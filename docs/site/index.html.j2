<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>F1 race pace</title>
  <meta name="description" content="Predicted race pace of every F1 driver after Saturday qualifying, against what happened on Sunday.">
  <link rel="stylesheet" href="site.css">
  <script src="site.js" defer></script>
</head>
<body>
  <div id="notice" role="status" hidden></div>
  <noscript><p>This page needs JavaScript to load the data.</p></noscript>
  <main>
    <section id="hero" aria-labelledby="hero-title">
      <h1 id="hero-title">F1 race pace</h1>
      <p id="hero-meta"></p>
      <p><a href="model.html">How the model works</a></p>
    </section>

    <section id="results" aria-labelledby="results-title">
      <h2 id="results-title">Results</h2>
      <div id="results-figures" class="figures">
        <article class="figure" data-metric="mae">
          <h3>MAE</h3>
          <p class="figure-value" data-role="champion">&mdash;</p>
          <p class="figure-baseline">Baseline <span data-role="baseline">&mdash;</span></p>
          <p class="figure-hint">Mean absolute error of the pace delta, lower is better.</p>
        </article>
        <article class="figure" data-metric="rmse">
          <h3>RMSE</h3>
          <p class="figure-value" data-role="champion">&mdash;</p>
          <p class="figure-baseline">Baseline <span data-role="baseline">&mdash;</span></p>
          <p class="figure-hint">Root mean squared error, lower is better.</p>
        </article>
        <article class="figure" data-metric="r2">
          <h3>R&sup2;</h3>
          <p class="figure-value" data-role="champion">&mdash;</p>
          <p class="figure-baseline">Baseline <span data-role="baseline">&mdash;</span></p>
          <p class="figure-hint">Share of the variation explained, higher is better.</p>
        </article>
        <article class="figure" data-metric="pairwise_acc">
          <h3>Pairwise accuracy</h3>
          <p class="figure-value" data-role="champion">&mdash;</p>
          <p class="figure-baseline">Baseline <span data-role="baseline">&mdash;</span></p>
          <p class="figure-hint">Pairs of drivers put in the right order, higher is better.</p>
        </article>
      </div>
      <div id="results-by-race"></div>
    </section>

    <section id="race" aria-labelledby="race-title">
      <h2 id="race-title">Race</h2>
      <label for="race-select">Race</label>
      <select id="race-select"></select>
      <p id="race-meta"></p>
      <table id="race-table"></table>
    </section>

    <section id="scatter" aria-labelledby="scatter-title">
      <h2 id="scatter-title">Predicted vs actual</h2>
      <svg id="scatter-plot" viewBox="0 0 560 520" role="img" aria-label="Predicted against actual pace of each driver"></svg>
      <p id="scatter-note"></p>
    </section>

    <section id="features" aria-labelledby="features-title" hidden>
      <h2 id="features-title">Features</h2>
      <div id="features-importance"></div>
    </section>
  </main>
</body>
</html>
